// Direct3D9 ps_2_0: 5-tap cross blur for the quarter-resolution glow.
// c0 = (oneTexelX, zero, zero, oneTexelY)
// c1 = (intensity/5, one, zero, zero)
ps_2_0
dcl t0.xy
dcl_2d s0
texld r0, t0, s0
add r1.xy, t0, c0.xy
texld r2, r1, s0
sub r1.xy, t0, c0.xy
texld r3, r1, s0
add r1.xy, t0, c0.zw
texld r4, r1, s0
sub r1.xy, t0, c0.zw
texld r5, r1, s0
add r0, r0, r2
add r0, r0, r3
add r0, r0, r4
add r0, r0, r5
mul r0.rgb, r0, c1.x
mov r0.a, c1.y
mov oC0, r0
