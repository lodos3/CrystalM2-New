// Direct3D9 ps_2_0: bright-colour extraction from the existing light buffer.
// c0 = (threshold, gain, zero, one)
ps_2_0
dcl t0.xy
dcl_2d s0
texld r0, t0, s0
max r1.x, r0.r, r0.g
max r1.x, r1.x, r0.b
add r1.x, r1.x, -c0.x
max r1.x, r1.x, c0.z
mul r0.rgb, r0, r1.x
mul r0.rgb, r0, c0.y
mov r0.a, c0.w
mov oC0, r0
