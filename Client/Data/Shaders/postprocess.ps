// Direct3D9 ps_2_0: one world-texture fetch; fog depth approximation,
// rain-surface highlight response, warm/cool grade and optional lightning.
// c0=(brightness, vignette strength, one, minimum vignette)
// c1=(UV centre.x, UV centre.y, zero, zero)
// c2=(time/weather tint.rgb, grade strength)
// c3=(haze strength, haze colour.rgb)
// c4=(wetness, horizon UV, fade slope, wet reflection factor)
// c5=(lightning strength, pale lightning colour.rgb)
// All optional values have zero strength by default; UI is shaded separately.
ps_2_0
dcl t0.xy
dcl v0
dcl_2d s0
texld r0, t0, s0
mul r0, r0, v0

// Screen-height-dependent distance fog; top of screen is the far plane.
add r5.x, c4.y, -t0.y
mul_sat r5.x, r5.x, c4.z
mul r5.x, r5.x, c3.x
lrp r0.rgb, r5.x, c3.yzw, r0

// Rain-wet highlights (LDR approximation, not geometric reflections).
max r6.x, r0.r, r0.g
max r6.x, r6.x, r0.b
mul r6.x, r6.x, c4.x
mul r6.x, r6.x, c4.w
add_sat r0.rgb, r0, r6.x

// Restrained contrast/vignette, then temperature grade.
add r1.xy, t0, -c1
mul r2.x, r1.x, r1.x
mad r2.x, r1.y, r1.y, r2.x
mad r2.x, -r2.x, c0.y, c0.z
max r2.x, r2.x, c0.w
mul r0.rgb, r0, c0.x
mul r0.rgb, r0, r2.x
mul r4.rgb, r0, c2
lrp r0.rgb, c2.a, r4, r0

// Optional soft exposure bump only on lightning-enabled rainy maps.
lrp r0.rgb, c5.x, c5.yzw, r0
mov oC0, r0
