// Direct3D9 ps_2_0: one texture lookup, colour grading and soft vignette.
// c0 = (brightness, vignette strength, 1.0, minimum brightness)
// c1 = (0.5, 0.5, 0, 0)
ps_2_0
dcl t0.xy
dcl v0
dcl_2d s0
texld r0, t0, s0
mul r0, r0, v0
add r1.xy, t0, -c1
mul r2.x, r1.x, r1.x
mad r2.x, r1.y, r1.y, r2.x
mad r2.x, -r2.x, c0.y, c0.z
max r2.x, r2.x, c0.w
mul r0.rgb, r0, c0.x
mul r0.rgb, r0, r2.x
mov oC0, r0
