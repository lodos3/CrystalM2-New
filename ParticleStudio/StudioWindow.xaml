<Window x:Class="CrystalM2.ParticleStudio.StudioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:forms="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        Title="CrystalM2 Particle Studio" Width="1320" Height="820" MinWidth="1000" MinHeight="620"
        Background="#14191F" Foreground="#E3E9F0" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#1A2129" />
        <SolidColorBrush x:Key="Edge" Color="#303A46" />
        <SolidColorBrush x:Key="Muted" Color="#A9B6C5" />
        <SolidColorBrush x:Key="Accent" Color="#E5BA78" />
        <Style TargetType="Button">
            <Setter Property="Background" Value="#293440" />
            <Setter Property="Foreground" Value="#F1F4F7" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"
                                BorderBrush="#3C4958" BorderThickness="1" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="#E5BA78" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="#E5BA78" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Frame" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#E3E9F0" />
            <Setter Property="Background" Value="#11171E" />
            <Setter Property="BorderBrush" Value="#405164" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="CaretBrush" Value="#E3E9F0" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="Foreground" Value="#18232E" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#D9E1EA" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#283340" />
            <Setter Property="Foreground" Value="#DCE6F0" />
            <Setter Property="Padding" Value="8,6" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="Foreground" Value="#E3E9F0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#35475B" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#1D2630" BorderBrush="{StaticResource Edge}" BorderThickness="0,0,0,1" Padding="18,12">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Open asset folder…" Click="OpenFolder" />
                    <Button Content="Reload" Click="Reload" />
                    <Button x:Name="ApplyButton" Content="Apply to client" IsEnabled="False" Click="ApplyToClient"
                            ToolTip="Apply the saved spell to the local client. Restart the client to load it." />
                    <Button x:Name="SaveButton" Content="Save spell" Click="Save" Background="#E5BA78"
                            Foreground="#1B2128" FontWeight="SemiBold" Margin="0" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="CRYSTALM2" FontSize="10" Foreground="{StaticResource Accent}" FontWeight="SemiBold" />
                    <TextBlock Text="Particle Studio" FontSize="24" FontWeight="SemiBold" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="#1D2630" BorderBrush="{StaticResource Edge}" BorderThickness="0,1,0,0" Padding="15,8">
            <DockPanel>
                <TextBlock x:Name="FolderText" DockPanel.Dock="Right" MaxWidth="510" Margin="16,0,0,0"
                           TextTrimming="CharacterEllipsis" Foreground="{StaticResource Muted}" />
                <TextBlock x:Name="Status" Text="Opening particle assets…" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <Grid Margin="11">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="218" MinWidth="180" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="350" MinWidth="270" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="1" Padding="11">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Spell library" FontSize="16" FontWeight="SemiBold" />
                        <ComboBox x:Name="ClassFilter" Margin="0,11,0,7" SelectionChanged="FilterChanged" AutomationProperties.Name="Spell class" />
                        <TextBox x:Name="SpellSearch" Margin="0,0,0,8" TextChanged="FilterChanged" ToolTip="Search spells by name"
                                 AutomationProperties.Name="Search spells" />
                        <TextBlock x:Name="LibraryCount" Foreground="{StaticResource Muted}" Margin="0,0,0,8" />
                    </StackPanel>
                    <ListBox x:Name="Spells" Background="#11171E" Foreground="#E3E9F0" BorderBrush="{StaticResource Edge}"
                             DisplayMemberPath="Name" SelectionChanged="SpellChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True" AutomationProperties.Name="Spell library" />
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="{StaticResource Edge}" ResizeDirection="Columns" />

            <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="12,10">
                        <TextBlock x:Name="PreviewTitle" Text="Preview" FontSize="17" FontWeight="SemiBold" />
                        <WrapPanel Margin="0,9,0,0" VerticalAlignment="Center">
                            <ComboBox x:Name="StagePicker" Width="150" Margin="0,0,8,4" SelectionChanged="StageChanged"
                                      AutomationProperties.Name="Spell stage" />
                            <ComboBox x:Name="DirectionPicker" Width="110" Margin="0,0,9,4" SelectionChanged="ViewChanged"
                                      AutomationProperties.Name="Facing direction" />
                            <CheckBox x:Name="Glow" Content="Glow" IsChecked="True" Margin="0,3,9,4"
                                      Checked="ViewChanged" Unchecked="ViewChanged" />
                            <CheckBox x:Name="Guide" Content="Rig" IsChecked="True" Margin="0,3,0,4"
                                      Checked="ViewChanged" Unchecked="ViewChanged" ToolTip="Show the preview rig anchor" />
                        </WrapPanel>
                        <WrapPanel Margin="0,3,0,0" VerticalAlignment="Center">
                            <Button Content="Client folder…" Click="OpenClientFolder" />
                            <Button Content="Map…" Click="OpenMap" />
                            <ComboBox x:Name="AmbientPicker" Width="88" Margin="0,0,8,0" SelectionChanged="ViewChanged"
                                      AutomationProperties.Name="Scene lighting" />
                            <CheckBox x:Name="ReferenceVisible" Content="Reference scene" IsChecked="True"
                                      Checked="ViewChanged" Unchecked="ViewChanged" />
                        </WrapPanel>
                        <TextBlock x:Name="ReferenceText" Foreground="{StaticResource Muted}" Margin="0,6,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <forms:WindowsFormsHost x:Name="ViewportHost" Grid.Row="1" Focusable="False" />
                    <StackPanel Grid.Row="2" Margin="12,9,12,11">
                        <DockPanel>
                            <TextBlock x:Name="ClockText" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                            <Slider x:Name="Timeline" Minimum="0" Maximum="1" SmallChange="16" LargeChange="100" ValueChanged="Seek"
                                    Margin="0,0,10,0" AutomationProperties.Name="Preview time in milliseconds" />
                        </DockPanel>
                        <WrapPanel Margin="0,7,0,0">
                            <Button x:Name="PlayButton" Content="Play  F1" Click="Play" />
                            <Button Content="−16 ms" Click="StepBack" ToolTip="Step back one 16 ms sample" />
                            <Button Content="+16 ms" Click="StepForward" ToolTip="Step forward one 16 ms sample" />
                            <CheckBox x:Name="Loop" Content="Loop" Margin="5,0,0,0" />
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="{StaticResource Edge}" ResizeDirection="Columns" />

            <Border Grid.Column="4" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="1" Padding="11">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <DockPanel LastChildFill="True">
                            <CheckBox x:Name="AllNodes" DockPanel.Dock="Right" Content="Advanced" Checked="NodesChanged" Unchecked="NodesChanged"
                                      ToolTip="Show all source nodes and settings, including inactive branches" />
                            <TextBlock Text="Layer settings" FontSize="16" FontWeight="SemiBold" />
                        </DockPanel>
                        <ComboBox x:Name="NodePicker" Margin="0,11,0,7" SelectionChanged="NodeChanged"
                                  AutomationProperties.Name="Spell layer" />
                        <TextBlock Text="Choose a layer, then edit a value or open its range or curve." Foreground="{StaticResource Muted}"
                                   TextWrapping="Wrap" Margin="0,0,0,8" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" Orientation="Horizontal">
                        <Button Content="Edit value..." Click="EditSelectedValue" />
                        <Button Content="Reset selected value" HorizontalAlignment="Left" Click="ResetValue" />
                    </StackPanel>
                    <DataGrid x:Name="Parameters" Background="#11171E" RowBackground="#151E28" AlternatingRowBackground="#192430"
                              Foreground="#E3E9F0" BorderBrush="{StaticResource Edge}" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="None"
                              SelectionMode="Single" SelectionUnit="FullRow" BeginningEdit="BeginParameterEdit" CellEditEnding="ParameterEdited"
                              EnableRowVirtualization="True" AutomationProperties.Name="Effect parameters">
                        <DataGrid.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" Foreground="#E5BA78" FontWeight="SemiBold" Margin="7,9,3,3" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </DataGrid.GroupStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Setting" Binding="{Binding Label}" IsReadOnly="True" Width="1.25*" />
                            <DataGridTextColumn Header="Value" Binding="{Binding Text, UpdateSourceTrigger=Explicit}" Width="*" />
                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" IsReadOnly="True" Width="69" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
